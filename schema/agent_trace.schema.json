{
  "$defs": {
    "StepStatus": {
      "enum": [
        "success",
        "error",
        "retry",
        "abandoned"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "StepType": {
      "enum": [
        "tool_call",
        "llm_call",
        "routing",
        "thought"
      ],
      "title": "StepType",
      "type": "string"
    },
    "TokenUsage": {
      "properties": {
        "prompt_tokens": {
          "default": 0,
          "title": "Prompt Tokens",
          "type": "integer"
        },
        "completion_tokens": {
          "default": 0,
          "title": "Completion Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "default": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "TraceStep": {
      "properties": {
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "step_index": {
          "title": "Step Index",
          "type": "integer"
        },
        "step_type": {
          "$ref": "#/$defs/StepType"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "input_payload": {
          "additionalProperties": true,
          "title": "Input Payload",
          "type": "object"
        },
        "output_payload": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Payload"
        },
        "status": {
          "$ref": "#/$defs/StepStatus",
          "default": "success"
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Message"
        },
        "latency_ms": {
          "default": 0.0,
          "title": "Latency Ms",
          "type": "number"
        },
        "tokens": {
          "$ref": "#/$defs/TokenUsage"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "step_id",
        "step_index",
        "step_type",
        "name"
      ],
      "title": "TraceStep",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "description": "Semver of the canonical AgentTrace JSON schema.",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "agent_name": {
      "title": "Agent Name",
      "type": "string"
    },
    "agent_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Version"
    },
    "task_input": {
      "additionalProperties": true,
      "title": "Task Input",
      "type": "object"
    },
    "final_output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Output"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "total_latency_ms": {
      "default": 0.0,
      "title": "Total Latency Ms",
      "type": "number"
    },
    "total_tokens": {
      "$ref": "#/$defs/TokenUsage"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "trace_id",
    "agent_name",
    "task_input"
  ],
  "title": "AgentTrace",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentdiff.dev/schemas/agent_trace.schema.json"
}
